// vinylTrack — generator and datasource only. This file has no models on
// purpose, and that does not mean the app has none.
//
// prisma.config.ts points `schema` at the src/prisma *directory*, not at a
// file, so Prisma loads every .prisma in it. The models live next door in
// collection.prisma (landed in issue #2, migrated).

generator client {
  provider      = "prisma-client"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}
