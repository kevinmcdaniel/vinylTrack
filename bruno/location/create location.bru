meta {
  name: create location
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/location
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "name": "_BRUNO_ Garage",
    "kind": "physical"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
}

script:post-response {
  bru.setVar("locationId", res.body.data.id);
}
