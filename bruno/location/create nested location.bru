meta {
  name: create nested location
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/location
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "name": "_BRUNO_ Crate 1",
    "kind": "physical",
    "collectionId": "{{vinylCollectionId}}",
    "parentLocationId": "{{locationId}}"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
}

script:post-response {
  bru.setVar("childLocationId", res.body.data.id);
}

tests {
  test("resolves the parent it was nested under", function() {
    expect(res.body.data.parent.name).to.equal("_BRUNO_ Garage");
  });
}
