meta {
  name: create location (missing collectionId)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/location
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "name": "_BRUNO_ No Collection",
    "kind": "physical"
  }
}

assert {
  res.status: eq 406
  res.body.status: eq 406
}

docs {
  A location is a child of exactly one collection (#53), so collectionId is required.
}
