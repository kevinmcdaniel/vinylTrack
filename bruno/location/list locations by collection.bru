meta {
  name: list locations by collection
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/location?collectionId={{digitalCollectionId}}
  body: none
  auth: inherit
}

params:query {
  collectionId: {{digitalCollectionId}}
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("returns only that collection's locations — what a picker offers (#8)", function() {
    const ids = (res.body.data || []).map(l => l.collectionId);
    expect(ids).to.not.have.lengthOf(0);
    expect(ids.every(id => id === bru.getVar("digitalCollectionId"))).to.equal(true);
  });

  test("the digital collection holds the iCloud folder, not the Basement", function() {
    const names = (res.body.data || []).map(l => l.name);
    expect(names).to.include("iCloud Drive/Music/SquareDance");
    expect(names).to.not.include("Basement");
  });
}
