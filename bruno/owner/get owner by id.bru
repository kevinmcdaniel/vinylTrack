meta {
  name: get owner by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/owner/{{ruthOwnerId}}
  body: none
  auth: inherit
}

headers {
  x-user-email: {{sharedEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("an owner row is global — any active user can read it", function() {
    expect(res.body.data.name).to.equal("Grandma Ruth");
  });
}
