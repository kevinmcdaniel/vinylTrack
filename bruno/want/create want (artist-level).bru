meta {
  name: create want (artist-level)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/want
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "collectionId": "{{vinylCollectionId}}",
    "artistId": "{{artistId}}",
    "priority": "nice-to-have",
    "notes": "anything else by them"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
}

script:post-response {
  bru.setVar("artistWantId", res.body.data.id);
}

docs {
  "More records by this artist" — the shopping-mode case where you do not have a specific title in mind.
}
