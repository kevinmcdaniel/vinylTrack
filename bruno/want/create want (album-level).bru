meta {
  name: create want (album-level)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/want
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "collectionId": "{{vinylCollectionId}}",
    "albumId": "{{albumId}}",
    "priority": "must-have"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
}

script:post-response {
  bru.setVar("albumWantId", res.body.data.id);
}
