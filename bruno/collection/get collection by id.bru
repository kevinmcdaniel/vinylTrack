meta {
  name: get collection by id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/collection/{{vinylCollectionId}}
  body: none
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("resolves the requested collection", function() {
    expect(res.body.data.name).to.equal("Squakville Vinyl");
    expect(res.body.data.kind).to.equal("physical");
  });
}
