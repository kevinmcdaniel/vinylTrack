meta {
  name: list collections (outsider)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/collection
  body: none
  auth: inherit
}

headers {
  x-user-email: {{outsiderEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("sees nothing, as an empty array rather than null", function() {
    expect(res.body.data).to.be.an("array").that.is.empty;
  });
}
