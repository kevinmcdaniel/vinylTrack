meta {
  name: update album (outsider)
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/api/album/{{albumId}}
  body: json
  auth: inherit
}

headers {
  x-user-email: {{outsiderEmail}}
}

body:json {
  {
    "notes": "not mine to edit"
  }
}

assert {
  res.status: eq 404
  res.body.status: eq 404
  res.body.data: isNull
}
