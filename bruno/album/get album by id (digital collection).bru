meta {
  name: get album by id (digital collection)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/album/{{plusCallsId}}
  body: none
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("reports kind digital, which de-emphasizes condition and source (#14)", function() {
    expect(res.body.data.collection.kind).to.equal("digital");
  });
}
