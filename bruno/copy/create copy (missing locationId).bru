meta {
  name: create copy (missing locationId)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/copy
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "albumId": "{{albumId}}",
    "ownerId": "{{kevinOwnerId}}"
  }
}

assert {
  res.status: eq 406
  res.body.status: eq 406
}
