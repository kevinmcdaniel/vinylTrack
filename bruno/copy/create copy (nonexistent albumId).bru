meta {
  name: create copy (nonexistent albumId)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/copy
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "albumId": "{{missingId}}",
    "locationId": "{{childLocationId}}",
    "ownerId": "{{kevinOwnerId}}"
  }
}

assert {
  res.status: eq 403
  res.body.status: eq 403
  res.body.data: isNull
}

docs {
  403, same as "create copy (outsider)" against a real album (#45). A copy has
  no collectionId of its own, so `requireCollectionAccessForCreate` resolves
  access through the album; a nonexistent album resolves to `null` and fails
  closed, so "no such album" and "not your album" can't be told apart. Admins
  bypass the check and still get the FK's 409.
}
