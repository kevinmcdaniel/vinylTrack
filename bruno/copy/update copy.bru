meta {
  name: update copy
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/copy/{{copyId}}
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "condition": "VG",
    "notes": "edited by the bruno run"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("persists the edit", function() {
    expect(res.body.data.condition).to.equal("VG");
  });
}
