meta {
  name: get copy by id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/copy/{{copyId}}
  body: none
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

tests {
  test("carries acquisition detail for the album detail screen", function() {
    expect(res.body.data.condition).to.equal("NM");
  });
}
