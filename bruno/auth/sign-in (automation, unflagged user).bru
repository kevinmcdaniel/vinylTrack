meta {
  name: sign-in (automation, unflagged user)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/sign-in
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{serviceToken}}
  x-automation-key: {{automationKey}}
}

body:json {
  { "provider": "dev", "email": "{{sharedEmail}}", "turnstileToken": "XXXX.DUMMY.TOKEN.XXXX" }
}

assert {
  res.status: eq 401
  res.body.data: isNull
}
