meta {
  name: magic-link (wrong automation key)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/magic-link
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{serviceToken}}
  x-automation-key: definitely-not-the-key
}

body:json {
  { "email": "{{ownerEmail}}", "url": "http://localhost:5201/api/auth/callback/email?token=bruno&email=x", "turnstileToken": "XXXX.DUMMY.TOKEN.XXXX" }
}

assert {
  res.status: eq 401
  res.body.data: isNull
}
