meta {
  name: sign-in (wrong automation key)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sign-in
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{serviceToken}}
  x-automation-key: definitely-not-the-key
}

body:json {
  { "provider": "dev", "email": "{{ownerEmail}}", "turnstileToken": "XXXX.DUMMY.TOKEN.XXXX" }
}

assert {
  res.status: eq 401
  res.body.data: isNull
}
