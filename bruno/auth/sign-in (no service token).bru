meta {
  name: sign-in (no service token)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/sign-in
  body: json
  auth: none
}

headers {
  x-user-email: {{ownerEmail}}
  x-automation-key: {{automationKey}}
}

body:json {
  { "provider": "dev", "email": "{{ownerEmail}}", "turnstileToken": "XXXX.DUMMY.TOKEN.XXXX" }
}

assert {
  res.status: eq 401
  res.body.data: isNull
}
