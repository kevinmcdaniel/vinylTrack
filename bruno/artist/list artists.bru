meta {
  name: list artists
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/artist
  body: none
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

script:post-response {
  const miles = (res.body.data || []).find(a => a.name === "Miles Davis");
  if (miles) bru.setVar("milesDavisId", miles.id);
}

tests {
  test("the database is not seeded — run: docker compose run --rm seed", function() {
    expect(res.body.data.map(a => a.name), "the database is not seeded — run: docker compose run --rm seed").to.include("Miles Davis");
  });

  test("list data is an array, never null", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("includes the seeded artist", function() {
    expect(res.body.data.map(a => a.name)).to.include("Miles Davis");
  });
}
