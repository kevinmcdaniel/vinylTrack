meta {
  name: list artists
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/artist
  body: none
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

assert {
  res.status: eq 200
  res.body.status: eq 200
}

script:post-response {
  bru.setVar("milesDavisId", res.body.data.find(a => a.name === "Miles Davis").id);
}

tests {
  test("list data is an array, never null", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("includes the seeded artist", function() {
    expect(res.body.data.map(a => a.name)).to.include("Miles Davis");
  });
}
