meta {
  name: create artist
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/artist
  body: json
  auth: inherit
}

headers {
  x-user-email: {{ownerEmail}}
}

body:json {
  {
    "name": "_BRUNO_ Test Artist",
    "sortName": "Test Artist, _BRUNO_"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
}

script:post-response {
  bru.setVar("artistId", res.body.data.id);
}

tests {
  test("echoes the created artist", function() {
    expect(res.body.data.name).to.equal("_BRUNO_ Test Artist");
    expect(res.body.data.id).to.be.a("string");
  });
}
