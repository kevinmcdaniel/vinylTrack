{
  "name": "mailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vinylTrack mailer — sends fixed-template email through the family Google Workspace (#62)",
  "scripts": {
    "dev": "npx nodemon --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "authorize": "tsx scripts/authorize.ts"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
