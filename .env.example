# vinylTrack environment variables
#
# Copy this file to `.env` at repo root and fill in real values where noted.
# Every service in docker-compose.yml mounts .env via env_file, so each var
# below is available inside every container regardless of which service uses it.
# Image-internal names (DATABASE_URL, POSTGRES_*, PGPORT, PORT) are remapped
# from these inside docker-compose.yml — do not set them here.

# ──────────────── Database ────────────────

# Postgres listen ports
DB_PORT_INT=5432                        # container-side
DB_PORT_EXT=5204                        # host-side (psql / external clients)

# Application database + role. The Postgres image creates this user/db on
# first run from POSTGRES_USER / POSTGRES_DB / POSTGRES_PASSWORD (mapped in
# docker-compose.yml). DB_VINYLTRACK_URL must use the same password.
DB_VINYLTRACK_NAME=vinyltrack
DB_VINYLTRACK_USER=vinyltrack
DB_VINYLTRACK_PW=change-me              # secret
# Password embedded in the URL must match DB_VINYLTRACK_PW.
DB_VINYLTRACK_URL="postgresql://vinyltrack:change-me@vinyl.db:5432/vinyltrack?schema=public"

# ──────────────── Backend ────────────────

BE_PORT_INT=3000                        # container-side BE port
BE_PORT_EXT=5202                        # host-side BE port (curl / Postman target)
BE_URL=http://vinyl.be                  # docker network DNS name; how FE reaches BE

# ──────────────── Frontend ────────────────

FE_PORT_INT=4000                        # container-side FE port
FE_PORT_EXT=5201                        # host-side FE port (browser target)

# ──────────────── Prisma Studio ────────────────

STUDIO_PORT_INT=5555                    # container-side Studio port
STUDIO_PORT_EXT=5203                    # host-side Studio port (browser target)
