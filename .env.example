# vinylTrack .env: optional in dev, host config in production (#65).
#
# This file is NOT for secrets. Secrets are Docker secret files:
#   dev:  dev-secrets/<name> (committed, fake values; see dev-secrets/README.md)
#   prod: /Users/_vinyltrack/secrets/<name> on the host
#
# Compose reads .env for ${...} interpolation only; no service loads it as an
# env_file. Everything below is optional in dev: the defaults are in
# docker-compose.yml.

# ──────────────── Dev: host-side port overrides ────────────────
# FE_PORT_EXT=5201       # browser target
# BE_PORT_EXT=5202       # curl / Bruno target
# STUDIO_PORT_EXT=5203   # Prisma Studio
# DB_PORT_EXT=5204       # psql / external clients

# ──────────────── Prod: host config (not secret, kept out of the public repo) ────────────────
# PUBLIC_HOSTNAME=vinyl.<family-domain>
